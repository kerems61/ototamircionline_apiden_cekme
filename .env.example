# Google Places API (New) — server-side seed için
GOOGLE_PLACES_API_KEY=

# Supabase — server-side (seed/cron için)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=

# Supabase — frontend (Vite ile expose edilir, sadece public key)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Vercel cron auth (Vercel dashboard'unda da aynı değeri set et)
CRON_SECRET=
